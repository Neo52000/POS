{
  "name": "@pos/tpe-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pont local HTTP ↔ TPE Caisse-AP (TCP) + impression ESC/POS pour Ma Papeterie POS",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
