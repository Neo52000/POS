{
  "name": "ma-papeterie-pos",
  "private": true,
  "version": "0.1.0",
  "description": "Ma Papeterie POS — caisse NF525 (Reine & Fils SAS, Chaumont)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter @pos/app e2e",
    "dev:pos": "pnpm --filter @pos/app dev",
    "dev:bridge": "pnpm --filter @pos/tpe-bridge dev",
    "dev:tpe-sim": "pnpm --filter @pos/tpe-bridge sim",
    "verify-chain": "tsx scripts/verify-chain.ts",
    "verify-archive": "tsx scripts/verify-archive.ts",
    "smoke:fiskaly": "tsx scripts/fiskaly-sandbox-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@supabase/supabase-js": "^2.117.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fflate": "^0.8.3",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
