{
  "name": "@pos/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:vectors": "tsx scripts/gen-hash-vectors.ts && prettier --write src/__fixtures__/hash-vectors.json",
    "gen:archive-vector": "tsx scripts/gen-archive-vector.ts && prettier --write src/__fixtures__/archive-vector.json"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
